# Credentials and local secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml
docs/github_token
/config/

# Python caches and environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# IDE and notebook state
.vscode/
.idea/
*.swp
*.swo
*~
.ipynb_checkpoints/
.cache/
htfa/monitoring/uae/assets/*.publication.lock
htfa/monitoring/uae/assets/daily-candidate-*/

# UAE pipeline intermediate outputs
/htfa/monitoring/uae/jobs/backups/
/htfa/monitoring/uae/jobs/processed/

# Untracked root-level debugging artifacts
/_*.py
/_*.ps1
/_*.json
/_*.csv

# Local data: keep only source documentation and pipeline scripts in Git
/data/**
!/data/**/
!/data/**/README.md

# Binary reference material stays local
/references-local/**
!/references-local/README.md
/docs/**/*.pdf
/docs/**/*.doc
/docs/**/*.docx
/docs/**/*.ppt
/docs/**/*.pptx
/docs/**/*.xls
/docs/**/*.xlsx
/docs/**/*.wps

# Databases, logs, temporary files, and generated outputs
*.db
*.duckdb*
*.sqlite
*.sqlite3
*.tmp
*.temp
*.log
*.cache
~$*.xlsx
~$*.xls
~$*.doc*
~$*.ppt*
outputs/
logs/
temp/
tmp/
data/nul

# Browser automation
.playwright-mcp/

# Windows portable build artifacts
/build/
/runtime/
/wheelhouse/

# Local reference binaries; only their documentation is versioned.
/references/*
!/references/README.md

# UAE module assets: raw evidence, credentials and research files stay local.
/htfa/monitoring/uae/assets/*
!/htfa/monitoring/uae/assets/*.md
!/htfa/monitoring/uae/assets/auto_update_all.bat
!/htfa/monitoring/uae/assets/阿联酋.xlsx
