!/data/UAE/uae.duckdb
*.sqlite
*.sqlite3
*.tmp
*.temp
*.log
*.cache
~$*.xlsx
~$*.xls
~$*.doc*
~$*.ppt*
outputs/
logs/
temp/
tmp/
data/nul

