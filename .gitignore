# Local data: keep only source documentation and pipeline scripts in Git
/data/**
!/data/**/
!/data/**/README.md
!/data/UAE/*.py
!/data/UAE/*.ps1
!/data/UAE/*.bat
!/data/UAE/scripts/*.py
!/data/UAE/scripts/*.ps1
!/data/UAE/scripts/*.bat
!/data/UAE/*.md
!/data/UAE/数据说明.md
# 唯一推送的数据库文件（经 Git LFS，见 .gitattributes）
!/data/UAE/uae.duckdb
/data/UAE/raw/
/data/UAE/工作搜索热度.csv

# Binary reference material stays local
/references-local/**
!/references-local/README.md
